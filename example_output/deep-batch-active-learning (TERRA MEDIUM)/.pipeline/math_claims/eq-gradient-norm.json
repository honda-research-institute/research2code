      "formal": {
        "lhs": "probability_sq_sum + 1 - 2 * p_y",
        "relation": "monotone_decreasing",
        "variables": [
          {
            "name": "p_y",
            "domain": [0, 1],
            "role": "variable"
          },
          {
            "name": "probability_sq_sum",
            "domain": [0, 1],
            "role": "parameter"
          }
        ]
      }
    }
  ]
}
