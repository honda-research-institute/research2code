    },
    "run_status": {
      "enum": [
        "passed",
        "degraded",
        "blocked"
      ],
      "title": "Run Status",
      "type": "string"
    },
    "stage_summary": {
      "items": {
        "$ref": "#/$defs/StageSummary"
      },
      "title": "Stage Summary",
      "type": "array"
    },
    "artifacts": {
      "items": {
        "$ref": "#/$defs/ArtifactRecord"
      },
      "title": "Artifacts",
      "type": "array"
    },
    "validation_summary": {
      "items": {
        "$ref": "#/$defs/ValidationRecord"
      },
      "title": "Validation Summary",
      "type": "array"
    },
    "references": {
      "$ref": "#/$defs/ManifestReferences"
    },
    "diagnostics": {
      "items": {
        "type": "string"
      },
      "title": "Diagnostics",
      "type": "array"
    },
    "delivery": {
      "anyOf": [
        {
          "$ref": "#/$defs/DeliveryVerdict"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "run_id",
    "paper_slug",
    "generated_at",
    "git_commit",
    "config_hash",
    "run_status",
    "stage_summary",
    "artifacts",
    "validation_summary",
    "references"
  ],
  "title": "FinalManifest",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://r2c.local/schemas/final_manifest/v1.9.0"
}
