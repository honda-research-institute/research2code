    "StubbedElement": {
      "additionalProperties": false,
      "description": "One component the pipeline could not build, shipped as an explicit\nself-identifying stub with a researcher-consumable work order (partial\ndelivery design \u00a73.1/\u00a73.3). Structured on purpose: the digest and the\nrecurrence counters aggregate these without string parsing.",
      "properties": {
        "element_id": {
          "description": "Methodology-contract element id the stub stands in for.",
          "title": "Element Id",
          "type": "string"
        },
        "role": {
          "description": "Contract ranking: `core` (core_methodology) dominates the surfaces; everything else is `supporting`.",
          "enum": [
            "core",
            "supporting"
          ],
          "title": "Role",
          "type": "string"
        },
        "work_order": {
          "description": "Run-directory-relative path to the work-order markdown.",
          "title": "Work Order",
          "type": "string"
        },
        "stub_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Run-directory-relative path to the stub module, when the stub is a code file.",
          "title": "Stub Path"
        }
      },
      "required": [
        "element_id",
        "role",
        "work_order"
      ],
      "title": "StubbedElement",
      "type": "object"
    },
