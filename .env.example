# R2C environment configuration.
# Copy this file to <repo-root>/.env (gitignored) and delete the lines you
# do not need (keep one R2C_MODEL and the key for its provider).
# ./r2c-start.sh sources it before starting opencode, and the Python entry
# points (pipeline driver, parse_pdf) load it too; a variable already
# exported in your shell always wins over the file.

# The model every R2C agent runs on, as opencode's <provider>/<model> id.
# Unset means google/gemini-flash-latest (free tier available). R2C was built
# and tuned on a self-hosted Qwen 27B model; expect quality and speed to
# vary by model, and see R2C_TIMEOUT_SCALE below for slower ones.
export R2C_MODEL="google/gemini-flash-latest"
# export R2C_MODEL="anthropic/claude-sonnet-5"
# export R2C_MODEL="openai/gpt-5.6-luna"

# API key for the provider R2C_MODEL names (or use `opencode auth login`).
export GOOGLE_GENERATIVE_AI_API_KEY="..."
# export ANTHROPIC_API_KEY="..."
# export OPENAI_API_KEY="..."

# Reasoning level, applied to every agent request. Unset means the
# provider's default. OpenAI models take an effort level; Anthropic models
# take an extended-thinking budget in tokens.
export R2C_REASONING_EFFORT="medium"     # openai: low | medium | high
export R2C_THINKING_BUDGET=8000          # anthropic: tokens, 1024 or more

# Multiplier on every agent dispatch timeout. The base budgets were
# calibrated on a self-hosted Qwen 27B; the default 3.0 gives hosted and
# free-tier models room. 0 removes the limits (a hung dispatch then never
# times out).
export R2C_TIMEOUT_SCALE=3.0

# Cap-burn detection keys on the model's max output tokens. The driver reads
# it from opencode at startup; set this only to override.
export R2C_PER_STEP_OUTPUT_CAP=65536

# PDF paper inputs are converted to markdown with Marker, run locally:
#   pip install marker-pdf        (https://github.com/datalab-to/marker)
#   brew install llama.cpp        (Marker's inference backend; Linux: see
#                                  https://github.com/ggml-org/llama.cpp/releases)
# Markdown (.md) inputs need none of this. Marker needs Python 3.10-3.13
# (its pinned pillow has no 3.14 wheel yet); on a newer interpreter install
# it into its own venv and point R2C_MARKER_BIN at that marker_single. Its
# first run downloads its models (several GB); a CPU parse takes minutes.
export R2C_MARKER_BIN="marker_single"   # only if it is not on PATH
export R2C_MARKER_USE_LLM=0             # Marker's own LLM assist (off; slower, needs Marker's provider key, Gemini via GOOGLE_API_KEY by default)
export R2C_MARKER_FORCE_OCR=0           # OCR every page (slow on CPU; for PDFs with a broken text layer)
export R2C_MARKER_ATTEMPT_TIMEOUT_S=1500
export R2C_MARKER_RETRIES=1

# Optional: extra no_proxy entries (comma-separated) the r2c plugin adds
# for every child process, for corporate-proxy machines.
export R2C_NO_PROXY_EXTRA=".your-internal-domain.example"
